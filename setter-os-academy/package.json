{
  "name": "setter-os-academy",
  "version": "0.1.0",
  "private": true,
  "description": "SETTER OS ACADEMY – nichtkommerzieller Prototyp (Vertical Slice). Learn the skill. Master the conversation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "vitest run tests/content.test.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "gen:sources": "node scripts/gen-source-register.mjs",
    "screenshots": "node e2e/screenshots.mjs",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
